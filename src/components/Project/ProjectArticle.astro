---
import Html from "../../icons/Technologies/Languages/Html.astro";
import Css from "../../icons/Technologies/Languages/Css.astro";
import Dart from "../../icons/Technologies/Languages/Dart.astro";
import Java from "../../icons/Technologies/Languages/Java.astro";
import Js from "../../icons/Technologies/Languages/Js.astro";
import Typescript from "../../icons/Technologies/Languages/Typescript.astro";
import Ast from "../../icons/Technologies/FrameworksLibraries/Ast.astro";
import React from "../../icons/Technologies/FrameworksLibraries/React.astro";
import Node from "../../icons/Technologies/FrameworksLibraries/Node.astro";
import Tailwind from "../../icons/Technologies/FrameworksLibraries/Tailwind.astro";
import Firebase from "../../icons/Technologies/FrameworksLibraries/Firebase.astro";
import Flutter from "../../icons/Technologies/FrameworksLibraries/Flutter.astro";
import Android from "../../icons/Technologies/FrameworksLibraries/Android.astro";
import Sqlite from "../../icons/Technologies/Databases/Sqlite.astro";
import Postgresql from "../../icons/Technologies/Databases/Postgresql.astro";
import SocialIcons from "../Global/SocialIcons.astro";
import Github from "../../icons/Social/Github.astro";
import Link from "../../icons/Social/Link.astro";
import Playstore from "../../icons/Social/Playstore.astro";
import Appstore from "../../icons/Social/Appstore.astro";
import { projectTags } from "../../config/projectsData.json";
import type { ProjectItem } from "../../config/types/configDataTypes";

interface Props {
  project: ProjectItem;
}

const { project } = Astro.props;

const TAG_ICONS: Record<string, any> = {
  Html,
  Css,
  Dart,
  Java,
  Js,
  Typescript,
  Ast,
  React,
  Node,
  Tailwind,
  Firebase,
  Flutter,
  Android,
  Sqlite,
  Postgresql,
};

const hasLinks = Boolean(project.github || project.link || project.playstore || project.appstore);
const projectImages = project.images?.length ? project.images : [project.image];
---

<article class="w-full max-w-4xl mx-auto py-8">
  <!-- Navegación de regreso -->
  <div class="mb-8">
    <a
      href="/projects"
      class="inline-flex items-center gap-x-2 text-sm font-medium text-neutral-600 dark:text-neutral-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="m15 18-6-6 6-6"></path>
      </svg>
      Volver a Proyectos
    </a>
  </div>

  <!-- SECCIÓN 1: Título y descripción corta (Todo el ancho) -->
  <header class="w-full mb-10 pb-8 border-b border-neutral-200 dark:border-neutral-800">
    <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold text-neutral-900 dark:text-white mb-4 tracking-tight">
      {project.title}
    </h1>
    <p class="text-lg sm:text-xl text-neutral-600 dark:text-neutral-300 max-w-3xl leading-relaxed text-pretty">
      {project.shortDescription}
    </p>
  </header>

  <!-- Contenido principal en columnas: Izquierda (Etiquetas, Enlaces, Contenido HTML) / Derecha (Imagen) -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
    <!-- LADO IZQUIERDO -->
    <div class="lg:col-span-7 flex flex-col gap-y-8">
      <!-- SECCIÓN 2: Lado izquierdo - Etiquetas -->
      <section>
        <h2 class="text-xs uppercase tracking-wider font-semibold text-neutral-500 dark:text-neutral-400 mb-3">
          Tecnologías y herramientas
        </h2>
        <ul class="flex flex-wrap gap-2">
          {project.tags.map((tagKey) => {
            const tag = projectTags[tagKey];
            if (!tag) return null;
            const IconComponent = TAG_ICONS[tag.icon];
            return (
              <li>
                <span class={`flex gap-x-2 rounded-full text-xs sm:text-sm ${tag.class} py-1.5 px-3 items-center shadow-sm font-medium`}>
                  {IconComponent && <IconComponent class="size-4" />}
                  {tag.name}
                </span>
              </li>
            );
          })}
        </ul>
      </section>

      <!-- SECCIÓN 3: Lado izquierdo - Enlaces de las tiendas o demo -->
      {hasLinks && (
        <section>
          <h2 class="text-xs uppercase tracking-wider font-semibold text-neutral-500 dark:text-neutral-400 mb-3">
            Enlaces y disponibilidad
          </h2>
          <div class="flex items-center gap-3 flex-wrap">
            {project.playstore && (
              <SocialIcons href={project.playstore}>
                <Playstore class="size-4" />
                Google Play
              </SocialIcons>
            )}
            {project.appstore && (
              <SocialIcons href={project.appstore}>
                <Appstore class="size-4" />
                App Store
              </SocialIcons>
            )}
            {project.link && (
              <SocialIcons href={project.link}>
                <Link class="size-4" />
                Demo en vivo
              </SocialIcons>
            )}
            {project.github && (
              <SocialIcons href={project.github}>
                <Github class="size-5" />
                Ver Código
              </SocialIcons>
            )}
          </div>
        </section>
      )}

      <!-- SECCIÓN 4: Lado izquierdo - Contenido HTML más grande -->
      {project.descriptionHtml && (
        <section class="pt-4 border-t border-neutral-200 dark:border-neutral-800">
          <h2 class="text-xs uppercase tracking-wider font-semibold text-neutral-500 dark:text-neutral-400 mb-4">
            Detalles del Proyecto
          </h2>
          <div
            class="text-neutral-700 dark:text-neutral-300 leading-relaxed space-y-4 text-pretty [&>p]:mb-3 [&>h3]:text-xl [&>h3]:font-bold [&>h3]:text-neutral-900 dark:[&>h3]:text-white [&>h3]:mt-6 [&>h3]:mb-2 [&>ul]:list-disc [&>ul]:pl-5 [&>ul]:space-y-2 [&>ul>li>strong]:text-neutral-900 dark:[&>ul>li>strong]:text-white [&>p>strong]:text-blue-600 dark:[&>p>strong]:text-blue-400 [&_a]:text-blue-600 dark:[&_a]:text-blue-400 [&_a]:font-medium [&_a]:underline [&_a]:underline-offset-4 hover:[&_a]:text-blue-500"
            set:html={project.descriptionHtml}
          />
        </section>
      )}
    </div>

    <!-- LADO DERECHO: Imágenes del proyecto -->
    <div class="lg:col-span-5 sticky top-24 flex flex-col gap-6">
      {projectImages.map((imgSrc, index) => (
        <button
          type="button"
          data-lightbox-trigger
          data-index={index}
          data-src={imgSrc}
          data-alt={`Captura ${index + 1} del proyecto ${project.title}`}
          aria-label={`Ampliar captura ${index + 1} del proyecto ${project.title}`}
          class="group relative block w-full text-left overflow-hidden rounded-2xl border border-neutral-200/80 dark:border-neutral-800 shadow-xl bg-neutral-100 dark:bg-neutral-800/50 cursor-zoom-in focus:outline-none focus:ring-2 focus:ring-blue-500"
        >
          <img
            src={imgSrc}
            alt={`Captura ${index + 1} del proyecto ${project.title}`}
            class="w-full h-auto object-cover object-top transition duration-500 group-hover:scale-105"
            loading={index === 0 ? "eager" : "lazy"}
          />
          <span class="pointer-events-none absolute bottom-3 right-3 inline-flex items-center gap-1.5 rounded-full bg-black/60 px-3 py-1.5 text-xs font-medium text-white opacity-0 backdrop-blur-sm transition-opacity duration-300 group-hover:opacity-100">
            <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"></circle>
              <path d="m21 21-4.3-4.3"></path>
              <path d="M11 8v6"></path>
              <path d="M8 11h6"></path>
            </svg>
            Ampliar
          </span>
        </button>
      ))}
    </div>
  </div>

  <!-- Modal / Popup de imagen ampliada -->
  <div
    id="image-lightbox"
    role="dialog"
    aria-modal="true"
    aria-label="Vista ampliada de imagen del proyecto"
    class="fixed inset-0 z-50 hidden items-center justify-center bg-black/85 p-4 sm:p-6 md:p-10 backdrop-blur-sm opacity-0 transition-opacity duration-200"
  >
    <!-- Botón cerrar -->
    <button
      type="button"
      id="lightbox-close"
      aria-label="Cerrar imagen"
      class="absolute top-4 right-4 z-10 inline-flex items-center justify-center rounded-full bg-neutral-900/80 p-2.5 text-neutral-200 hover:bg-neutral-800 hover:text-white border border-neutral-700/70 transition focus:outline-none focus:ring-2 focus:ring-blue-500"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M18 6 6 18"></path>
        <path d="m6 6 12 12"></path>
      </svg>
    </button>

    {projectImages.length > 1 && (
      <>
        <!-- Botón anterior -->
        <button
          type="button"
          id="lightbox-prev"
          aria-label="Imagen anterior"
          class="absolute left-3 sm:left-6 z-10 inline-flex items-center justify-center rounded-full bg-neutral-900/80 p-2.5 text-neutral-200 hover:bg-neutral-800 hover:text-white border border-neutral-700/70 transition focus:outline-none focus:ring-2 focus:ring-blue-500"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m15 18-6-6 6-6"></path>
          </svg>
        </button>

        <!-- Botón siguiente -->
        <button
          type="button"
          id="lightbox-next"
          aria-label="Imagen siguiente"
          class="absolute right-3 sm:right-6 z-10 inline-flex items-center justify-center rounded-full bg-neutral-900/80 p-2.5 text-neutral-200 hover:bg-neutral-800 hover:text-white border border-neutral-700/70 transition focus:outline-none focus:ring-2 focus:ring-blue-500"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m9 18 6-6-6-6"></path>
          </svg>
        </button>
      </>
    )}

    <!-- Contenedor de la imagen -->
    <div class="relative flex flex-col items-center justify-center max-w-6xl max-h-full w-full">
      <img
        id="lightbox-image"
        src=""
        alt=""
        class="max-h-[85vh] max-w-full w-auto h-auto object-contain rounded-xl shadow-2xl border border-neutral-800/80 select-none transition-transform duration-200 scale-95"
      />
      {projectImages.length > 1 && (
        <div
          id="lightbox-counter"
          class="mt-3 rounded-full bg-neutral-900/80 border border-neutral-700/70 px-3.5 py-1 text-xs font-medium text-neutral-300"
        >
          1 / {projectImages.length}
        </div>
      )}
    </div>
  </div>
</article>

<script>
  function initLightbox() {
    const triggers = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-lightbox-trigger]'));
    const lightbox = document.getElementById('image-lightbox');
    const lightboxImg = document.getElementById('lightbox-image') as HTMLImageElement | null;
    const closeBtn = document.getElementById('lightbox-close');
    const prevBtn = document.getElementById('lightbox-prev');
    const nextBtn = document.getElementById('lightbox-next');
    const counter = document.getElementById('lightbox-counter');

    if (!lightbox || !lightboxImg || triggers.length === 0) return;

    let currentIndex = 0;

    const updateImage = (index: number) => {
      currentIndex = (index + triggers.length) % triggers.length;
      const trigger = triggers[currentIndex];
      const src = trigger.dataset.src || '';
      const alt = trigger.dataset.alt || '';

      lightboxImg.src = src;
      lightboxImg.alt = alt;

      if (counter) {
        counter.textContent = `${currentIndex + 1} / ${triggers.length}`;
      }
    };

    const openLightbox = (index: number) => {
      updateImage(index);
      lightbox.classList.remove('hidden');
      lightbox.classList.add('flex');
      document.body.style.overflow = 'hidden';

      requestAnimationFrame(() => {
        lightbox.classList.remove('opacity-0');
        lightbox.classList.add('opacity-100');
        lightboxImg.classList.remove('scale-95');
        lightboxImg.classList.add('scale-100');
      });
    };

    const closeLightbox = () => {
      lightbox.classList.remove('opacity-100');
      lightbox.classList.add('opacity-0');
      lightboxImg.classList.remove('scale-100');
      lightboxImg.classList.add('scale-95');
      document.body.style.overflow = '';

      setTimeout(() => {
        lightbox.classList.remove('flex');
        lightbox.classList.add('hidden');
        lightboxImg.src = '';
      }, 200);
    };

    triggers.forEach((trigger, idx) => {
      trigger.addEventListener('click', () => openLightbox(idx));
    });

    closeBtn?.addEventListener('click', closeLightbox);

    prevBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      updateImage(currentIndex - 1);
    });

    nextBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      updateImage(currentIndex + 1);
    });

    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox || (e.target as HTMLElement).parentElement === lightbox) {
        closeLightbox();
      }
    });

    document.addEventListener('keydown', (e) => {
      if (lightbox.classList.contains('hidden')) return;

      if (e.key === 'Escape') {
        closeLightbox();
      } else if (e.key === 'ArrowLeft' && triggers.length > 1) {
        updateImage(currentIndex - 1);
      } else if (e.key === 'ArrowRight' && triggers.length > 1) {
        updateImage(currentIndex + 1);
      }
    });
  }

  initLightbox();
  document.addEventListener('astro:page-load', initLightbox);
</script>
