---
import Github from "../icons/Social/Github.astro";
import { footerData } from "../config/footerData.json";
---

<footer class="m-4 mt-8 w-full mx-auto container lg:max-w-4xl md:max-w-2xl mb-10 flex justify-center text-neutral-600 dark:text-neutral-400">
    <div class="rounded-lg w-full max-w-screen-xl mx-auto md:flex md:items-center md:justify-between py-4"> 
        <span class="text-sm sm:text-center flex items-center">
            <a href={footerData.githubUrl} target="_blank" 
            rel="noopener noreferrer" class="hover:underline hover:text-blue-600 dark:hover:text-blue-400 flex items-center ml-2 transition-colors">
                <Github class="size-4 md:size-6 mr-2"/>
                {footerData.name}
            </a>. 
        </span> 
    </div> 
</footer>
