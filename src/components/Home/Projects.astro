---
import ProjectCard from "../Project/ProjectCard.astro";
import { projectsData } from "../../config/projectsData.json";

interface Props {
  limit?: number;
  showViewAll?: boolean;
}

const { limit = 3, showViewAll = true } = Astro.props;

const displayedProjects = limit ? projectsData.slice(0, limit) : projectsData;
---

<div class="flex flex-col gap-y-12">
  {displayedProjects.map((project) => (
    <ProjectCard project={project} headingLevel="h3" />
  ))}

  {showViewAll && (
    <div class="flex justify-center mt-6">
      <a
        href="/projects"
        class="inline-flex items-center gap-x-2 px-6 py-3 rounded-full text-sm font-semibold text-white bg-blue-600 hover:bg-blue-700 dark:bg-blue-600 dark:hover:bg-blue-500 transition-all shadow-md hover:shadow-lg hover:-translate-y-0.5"
      >
        Ver todos los proyectos
        <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14"></path>
          <path d="m12 5 7 7-7 7"></path>
        </svg>
      </a>
    </div>
  )}
</div>
