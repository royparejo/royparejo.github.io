---
import Html from "../../icons/Technologies/Languages/Html.astro";
import Css from "../../icons/Technologies/Languages/Css.astro";
import Dart from "../../icons/Technologies/Languages/Dart.astro";
import Java from "../../icons/Technologies/Languages/Java.astro";
import Js from "../../icons/Technologies/Languages/Js.astro";
import React from "../../icons/Technologies/FrameworksLibraries/React.astro";
import Firebase from "../../icons/Technologies/FrameworksLibraries/Firebase.astro";
import Flutter from "../../icons/Technologies/FrameworksLibraries/Flutter.astro";
import Android from "../../icons/Technologies/FrameworksLibraries/Android.astro";
import Sqlite from "../../icons/Technologies/Databases/Sqlite.astro";
import SocialIcons from "../Global/SocialIcons.astro";
import Github from "../../icons/Social/Github.astro";
import Link from "../../icons/Social/Link.astro";
import Playstore from "../../icons/Social/Playstore.astro";
import Appstore from "../../icons/Social/Appstore.astro";
import { projectsData, projectTags } from "../../config/projectsData.json";

const TAG_ICONS: Record<string, any> = {
  Html,
  Css,
  Dart,
  Java,
  Js,
  React,
  Firebase,
  Flutter,
  Android,
  Sqlite,
};
---

<div class="flex flex-col gap-y-16">
  {projectsData.map(({ image, title, description, tags, link, github, playstore, appstore }) => (
    <article class="flex flex-col md:flex-row md:space-x-8 space-y-8 md:space-y-0">
      <div class="w-full md:w-1/2 flex items-center group">
        <div class="relative flex flex-col items-center transition duration-500 ease-in-out transform shadow-xl overflow-hidden rounded-xl sm:rounded-xl border border-neutral-200/80 dark:border-gray-800 group-hover:shadow-2xl">
          <img
            alt={`Captura del Proyecto ${title}`}
            class="object-cover object-top w-full h-full transition duration-500 sm:h-full md:scale-110 md:group-hover:scale-105"
            loading="lazy"
            src={image}
          />
        </div>
      </div>

      <div class="w-full md:w-1/2 flex flex-col justify-center">
        <h3 class="text-2xl font-bold mb-2 text-neutral-900 dark:text-white">{title}</h3>
        <div class="flex flex-wrap mt-2">
          <ul class="flex flex-row mb-2 gap-x-2 flex-wrap">
            {tags.map((tagKey) => {
              const tag = projectTags[tagKey];
              if (!tag) return null;
              const IconComponent = TAG_ICONS[tag.icon];
              return (
                <li class="my-1">
                  <span class={`flex gap-x-2 rounded-full text-xs ${tag.class} py-1 px-2.5 items-center shadow-sm`}>
                    {IconComponent && <IconComponent class="size-4" />}
                    {tag.name}
                  </span>
                </li>
              );
            })}
          </ul>
        </div>

        <div class="mt-2 text-lg mb-4 text-neutral-700 dark:text-neutral-300">{description}</div>

        <footer class="flex items-end justify-start mt-4 gap-x-4 flex-wrap gap-y-2">
          {github && (
            <SocialIcons href={github}>
              <Github class="size-5" />
              Code
            </SocialIcons>
          )}
          {link && (
            <SocialIcons href={link}>
              <Link class="size-4" />
              Preview
            </SocialIcons>
          )}
          {playstore && (
            <SocialIcons href={playstore}>
              <Playstore class="size-4" />
              Google Play
            </SocialIcons>
          )}
          {appstore && (
            <SocialIcons href={appstore}>
              <Appstore class="size-4" />
              App Store
            </SocialIcons>
          )}
        </footer>
      </div>
    </article>
  ))}
</div>
