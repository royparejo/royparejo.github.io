---
import { certificatesData } from "../../config/certificatesData.json";
---

<div class="container px-5 py-6 mx-auto">
    {certificatesData.map((item) => (
        <div class="flex items-center lg:w-3/5 mx-auto border-b pb-10 mb-10 border-neutral-300 dark:border-gray-800 sm:flex-row flex-col">
            {item.imagePosition === "left" && (
                <img
                    src={item.logoUrl}
                    class="w-48 h-20 sm:mr-20 mb-4 sm:mb-0 object-contain"
                    alt={item.logoAlt}
                />
            )}
            <div class="flex-grow sm:text-left text-center mt-6 sm:mt-0">
                <h2 class="text-neutral-900 dark:text-white text-2xl mb-2 font-bold">{item.title}</h2>
                <p class="text-xl mb-2 font-semibold text-neutral-800 dark:text-neutral-200">{item.institution}</p>
                <p class="leading-relaxed text-base text-neutral-700 dark:text-neutral-300">{item.description}</p>
                <a
                    href={item.certificateUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="mt-3 text-indigo-600 dark:text-indigo-400 inline-flex items-center hover:underline font-medium"
                >
                    Ver Certificado
                </a>
            </div>
            {item.imagePosition === "right" && (
                <img
                    src={item.logoUrl}
                    class="w-48 h-20 sm:ml-20 mb-4 sm:mb-0 object-contain"
                    alt={item.logoAlt}
                />
            )}
        </div>
    ))}
</div>
