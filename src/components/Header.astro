---
import { navData } from '../config/navData.json';
---

<header class="flex justify-center items-center mx-auto py-5 sticky top-0 w-full xl:w-[1120px] z-10">
    <nav class="flex flex-wrap justify-center items-center px-3 text-sm font-medium rounded-full">
        {navData.map((item) => (
            <a class="hover:bg-white/10 rounded-full px-3 py-1 transition text-base md:text-sm" href={item.href}>
                {item.name}
            </a>
        ))}
    </nav>
</header>
