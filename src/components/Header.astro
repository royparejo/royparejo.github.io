---
import { navData } from '../config/navData.json';
import ThemeToggle from './ThemeToggle.astro';

const homeItem = navData[0] || { name: "Inicio", href: "#top" };
const otherNavItems = navData.slice(1);
---

<header class="fixed top-0 z-50 flex items-center justify-center w-full px-4 py-3 sm:py-4">
    <div class="flex items-center justify-between w-full max-w-4xl px-4 py-2 text-sm font-medium transition-all duration-300 rounded-full shadow-lg backdrop-blur-md bg-white/75 dark:bg-neutral-900/80 border border-neutral-200/80 dark:border-neutral-800 text-neutral-800 dark:text-neutral-200">
        <!-- Inicio alineado a la izquierda -->
        <a
            href={homeItem.href}
            class="flex items-center px-3 py-1.5 rounded-full font-semibold text-neutral-900 dark:text-white hover:text-blue-600 dark:hover:text-blue-400 hover:bg-neutral-200/50 dark:hover:bg-white/10 transition-colors"
        >
            {homeItem.name}
        </a>

        <!-- Resto de enlaces y botón de tema a la derecha -->
        <nav class="flex items-center gap-x-1 sm:gap-x-2">
            {otherNavItems.map((item) => (
                <a
                    href={item.href}
                    class="px-2.5 sm:px-3 py-1.5 rounded-full text-xs sm:text-sm font-medium text-neutral-700 dark:text-neutral-300 hover:text-blue-600 dark:hover:text-blue-400 hover:bg-neutral-200/50 dark:hover:bg-white/10 transition-colors"
                >
                    {item.name}
                </a>
            ))}
            <div class="pl-1 sm:pl-2 ml-1 border-l border-neutral-300 dark:border-neutral-700 flex items-center">
                <ThemeToggle />
            </div>
        </nav>
    </div>
</header>
