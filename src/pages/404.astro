---
import Layout from '../layouts/Layout.astro';
import Section from '../components/Global/Section.astro';
---

<Layout title="404 - Página no encontrada" description="La página que buscas no existe.">
  <main class="px-4">
    <Section>
      <div class="flex flex-col items-center justify-center text-center min-h-[50vh]">
        <h1 class="text-6xl font-bold text-blue-600 dark:text-blue-400 mb-4">404</h1>
        <p class="text-xl text-neutral-700 dark:text-neutral-300 mb-8">Página no encontrada</p>
        <a
          href="/"
          class="px-5 py-2.5 rounded-full bg-blue-600 text-white font-medium hover:bg-blue-700 transition shadow"
        >
          Volver al Inicio
        </a>
      </div>
    </Section>
  </main>
</Layout>
