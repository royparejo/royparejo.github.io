---
import Layout from '../layouts/Layout.astro';
import SocialIcons from '../components/Global/SocialIcons.astro';
import Section from '../components/Global/Section.astro';
import Code from '../icons/Titles/Code.astro';
import Projects from '../components/Home/Projects.astro';
import AboutMe from '../components/Home/AboutMe.astro';
import AboutMeIcon from '../icons/Titles/AboutMeIcon.astro';
import AboutMeSection from '../components/Home/AboutMeSection.astro';
import Footer from '../components/Global/Footer.astro';
import Linkedin from '../icons/Social/Linkedin.astro';
import Github from '../icons/Social/Github.astro';
import Gmail from '../icons/Social/Gmail.astro';
import Stackoverflow from '../icons/Social/Stackoverflow.astro';
import Discord from '../icons/Social/Discord.astro';
import { heroData } from '../config/heroData.json';

const SOCIAL_ICONS: Record<string, any> = {
  Linkedin,
  Github,
  Gmail,
  Stackoverflow,
  Discord,
};
---

<Layout title={heroData.metaTitle} description={heroData.metaDescription}>
	<main class="px-4">
		<Section>
			<img
				class="rounded-full w-20 h-20 mb-4 ring-2 ring-neutral-300 dark:ring-neutral-700 shadow-md" 
				src={heroData.avatarUrl}
				alt={heroData.avatarAlt}
			/> 
			<h1 class="text-neutral-900 dark:text-white text-3xl md:text-4xl lg:text-5xl font-bold flex flex-row gap-x-5 pb-6 lg:pb-10">
				Hola, Soy {heroData.name} 
			</h1>
			<h2 class="text-xl lg:text-2xl text-neutral-700 dark:text-neutral-300 text-pretty max-w-[700px] [&>strong]:text-blue-600 dark:[&>strong]:text-blue-400">
				<span class="text-blue-600 dark:text-blue-400 font-semibold">{heroData.role}</span><br/>
				<Fragment set:html={heroData.bioHtml} />
			</h2>
			<nav class="flex gap-x-5 mt-6 flex-wrap">
				{heroData.socialLinks.map((social) => {
					const IconComponent = SOCIAL_ICONS[social.icon];
					return (
						<SocialIcons href={social.url}>
							{IconComponent && <IconComponent class="size-4 md:size-6" />}
							{social.displayText || social.name}
						</SocialIcons>
					);
				})}
			</nav>
		</Section>
		<Section id="proyectos" class="max-w-6xl">
			<div class="flex justify-center">
				<h2 class="text-4xl font-semibold pb-10 flex gap-x-3 items-center text-center mb-4 text-neutral-900 dark:text-white">
					<Code class="size-8" />Últimos proyectos
				</h2>
			</div>
			<Projects limit={4} showViewAll={true} />
		</Section>
		<AboutMeSection id="sobre_mi">
			<div class="flex justify-center">
				<h2 class="text-4xl font-semibold pb-10 flex gap-x-3 items-center text-center mb-4 text-neutral-900 dark:text-white">
					<AboutMeIcon class="size-8" />Sobre mí
				</h2>
			</div>
			<AboutMe />
		</AboutMeSection>
		<Footer />
	</main>
</Layout>
