---
import Layout from '../layouts/Layout.astro';
import SocialIcons from '../components/SocialIcons.astro';
import Section from '../components/Section.astro';
import TechnologiesSection from '../components/TechnologiesSection.astro';
import Technologies from '../components/Technologies.astro';
import Code from '../icons/Titles/Code.astro';
import Projects from '../components/Projects.astro';
import AboutMe from '../components/AboutMe.astro';
import AboutMeIcon from '../icons/Titles/AboutMeIcon.astro';
import AboutMeSection from '../components/AboutMeSection.astro';
import Footer from '../components/Footer.astro';
import Linkedin from '../icons/Social/Linkedin.astro';
import Github from '../icons/Social/Github.astro';
import Gmail from '../icons/Social/Gmail.astro';
import Stackoverflow from '../icons/Social/Stackoverflow.astro';
import Discord from '../icons/Social/Discord.astro';
import { heroData } from '../config/heroData.json';

const SOCIAL_ICONS: Record<string, any> = {
  Linkedin,
  Github,
  Gmail,
  Stackoverflow,
  Discord,
};
---

<Layout title={heroData.metaTitle} description={heroData.metaDescription}>
	<main class="px-4">
		<Section>
			<img
				class="rounded-full w-20 h-20 mb-4" 
				src={heroData.avatarUrl}
				alt={heroData.avatarAlt}
			/> 
			<h1 class="text-white text-3xl md:text-4xl lg:text-5xl font-bold flex flex-row gap-x-5 pb-6 lg:pb-10">
				Hola, Soy {heroData.name} 
			</h1>
			<h2 class="text-xl lg:text-2xl opacity-80 text-pretty max-w-[700px]">
				<span class="text-blue-300">{heroData.role}</span><br/>
				<Fragment set:html={heroData.bioHtml} />
			</h2>
			<nav class="flex gap-x-5 mt-6 flex-wrap">
				{heroData.socialLinks.map((social) => {
					const IconComponent = SOCIAL_ICONS[social.icon];
					return (
						<SocialIcons href={social.url}>
							{IconComponent && <IconComponent class="size-4 md:size-6" />}
							{social.displayText || social.name}
						</SocialIcons>
					);
				})}
			</nav>
		</Section>
		<TechnologiesSection id="tecnologias">
			<Technologies />
		</TechnologiesSection>
		<Section id="proyectos">
			<div class="flex justify-center">
				<h2 class="text-4xl font-semibold pb-10 flex gap-x-3 items-center text-center mb-4">
					<Code class="size-8 " />Proyectos
				</h2>
			</div>
			<Projects />
		</Section>
		<AboutMeSection id="sobre_mi">
			<div class="flex justify-center">
				<h2 class="text-4xl font-semibold pb-10 flex gap-x-3 items-center text-center mb-4">
					<AboutMeIcon class="size-8 " />Sobre mí
				</h2>
			</div>
			<AboutMe />
		</AboutMeSection>
		<Footer />
	</main>
</Layout>
