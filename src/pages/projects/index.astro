---
import Layout from '../../layouts/Layout.astro';
import Section from '../../components/Global/Section.astro';
import ProjectsList from '../../components/Project/ProjectsList.astro';
import Code from '../../icons/Titles/Code.astro';
---

<Layout title="Proyectos - Roy Parejo" description="Listado de proyectos y aplicaciones desarrolladas por Roy Parejo.">
  <main class="px-4">
    <Section>
      <div class="flex flex-col items-center mb-12">
        <h1 class="text-4xl font-semibold flex gap-x-3 items-center text-center text-neutral-900 dark:text-white">
          <Code class="size-8" />Proyectos
        </h1>
        <p class="mt-3 text-neutral-600 dark:text-neutral-400 text-center max-w-xl">
          Explora todas las aplicaciones móviles y soluciones tecnológicas que he desarrollado.
        </p>
      </div>
      <ProjectsList />
    </Section>
  </main>
</Layout>
