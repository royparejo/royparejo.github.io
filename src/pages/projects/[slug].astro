---
import Layout from '../../layouts/Layout.astro';
import Section from '../../components/Global/Section.astro';
import ProjectArticle from '../../components/Project/ProjectArticle.astro';
import { projectsData } from '../../config/projectsData.json';
import type { ProjectItem } from '../../config/types/configDataTypes';

export function getStaticPaths() {
  return projectsData.map((project) => ({
    params: {
      slug: project.slug || project.title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, ''),
    },
    props: { project },
  }));
}

interface Props {
  project: ProjectItem;
}

const { project } = Astro.props;
---

<Layout title={`${project.title} - Roy Parejo`} description={project.shortDescription}>
  <main class="px-4">
    <Section>
      <ProjectArticle project={project} />
    </Section>
  </main>
</Layout>
