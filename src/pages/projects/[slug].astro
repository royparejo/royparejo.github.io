---
import Layout from '../../layouts/Layout.astro';
import Section from '../../components/Global/Section.astro';
import { projectsData } from '../../config/projectsData.json';

export function getStaticPaths() {
  return projectsData.map((project) => ({
    params: {
      slug: project.title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, ''),
    },
    props: { project },
  }));
}

const { project } = Astro.props;
---

<Layout title={`${project.title} - Roy Parejo`} description={project.description}>
  <main class="px-4">
    <Section>
      <div class="flex flex-col items-center text-center">
        <h1 class="text-3xl md:text-4xl font-bold mb-4 text-neutral-900 dark:text-white">{project.title}</h1>
        <p class="text-lg text-neutral-700 dark:text-neutral-300 mb-6 max-w-2xl">{project.description}</p>
        <a href="/#proyectos" class="text-blue-600 dark:text-blue-400 hover:underline font-medium">
          &larr; Volver a Proyectos
        </a>
      </div>
    </Section>
  </main>
</Layout>
